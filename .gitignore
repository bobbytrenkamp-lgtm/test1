# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# pytest
.pytest_cache/
.cache/

# Node (jsdom/Playwright are dev-only test tools, never a runtime dependency —
# see tests/e2e_smoke.mjs and AI_CONTEXT.md's Testing section for setup)
node_modules/

# Parcel pipeline generated drafts — data/parcel_pipeline/generate_entry.mjs
# output, never auto-committed (see that file's header comment). Human
# review copies the content into js/parcel/registry.js by hand.
data/parcel_pipeline/drafts/

# Parcel batch discovery run output — data/parcel_pipeline/discover_batch.mjs
# writes full untruncated per-run JSON (targets/candidates/raw responses)
# here for CI-artifact upload, never committed.
data/parcel_pipeline/output/

# Static parcel ingestion raw downloads only — the ORIGINAL government
# Shapefile/GeoPackage/ZIP a source resolves to, which can be tens of MB and
# is fully reproducible from download_url. The small per-source
# manifest.json files under this same state/ directory ARE committed (not
# ignored) because the next scheduled run needs their etag/checksum on disk
# to skip work when a source hasn't changed — see pipeline.py's
# update-check-before-expensive-work discipline.
data/parcel_pipeline/static_ingestion/state/raw/
data/parcel_pipeline/static_ingestion/state/*.converted.geojson

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
